        <h2 style="font-size:20px;font-weight:700;margin:0;">Appointments</h2>
        <button onclick="document.getElementById('appt-form').style.display = document.getElementById('appt-form').style.display === 'none' ? 'block' : 'none'" style="background:#C9A84C;color:#0A0A0A;border:none;padding:10px 16px;border-radius:8px;font-weight:600;cursor:pointer;">+ New</button>
      </div>
      
      <div id="appt-form" style="display:none;background:rgba(201,168,76,0.08);border:1px solid rgba(201,168,76,0.15);border-radius:12px;padding:16px;margin-bottom:20px;grid-template-columns:1fr 1fr;gap:12px;display:none;">
        <input id="appt-name" placeholder="Client name" style="padding:10px;background:rgba(0,0,0,0.3);border:1px solid rgba(201,168,76,0.15);border-radius:6px;color:#FFF;font-size:13px;">
        <input id="appt-phone" placeholder="Phone" style="padding:10px;background:rgba(0,0,0,0.3);border:1px solid rgba(201,168,76,0.15);border-radius:6px;color:#FFF;font-size:13px;">
        <input id="appt-date" type="date" style="padding:10px;background:rgba(0,0,0,0.3);border:1px solid rgba(201,168,76,0.15);border-radius:6px;color:#FFF;font-size:13px;">
        <input id="appt-time" type="time" style="padding:10px;background:rgba(0,0,0,0.3);border:1px solid rgba(201,168,76,0.15);border-radius:6px;color:#FFF;font-size:13px;">
        <input id="appt-service" placeholder="Service" style="padding:10px;background:rgba(0,0,0,0.3);border:1px solid rgba(201,168,76,0.15);border-radius:6px;color:#FFF;font-size:13px;grid-column:1/-1;">
        <button onclick="window.saveSalonAppointment()" style="background:#C9A84C;color:#0A0A0A;border:none;padding:10px;border-radius:6px;font-weight:600;cursor:pointer;">Save</button>
        <button onclick="document.getElementById('appt-form').style.display='none'" style="background:rgba(201,168,76,0.15);color:#FFF;border:none;padding:10px;border-radius:6px;cursor:pointer;">Cancel</button>
