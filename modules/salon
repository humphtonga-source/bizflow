// BIZFLOW SALON MODULE - COMPLETE & PRODUCTION READY
async function MODULE_INIT() {
  console.log('[Salon] initializing...');
  try {
    await initSalonDashboard();
    setupSalonMenu();
    console.log('[Salon] ready');
  } catch (err) {
    console.error('[Salon] init error:', err);
  }
}

// DASHBOARD
window.initSalonDashboard = async function() {
  const pane = document.getElementById('pane-dashboard');
  if (!pane) return;
  
  try {
    const today = new Date().toISOString().split('T')[0];
    const { data: todayAppts } = await STATE.supabase.from('salon_appointments').select('*').eq('business_id', STATE.businessId).eq('date', today);
    const { data: allAppts } = await STATE.supabase.from('salon_appointments').select('*').eq('business_id', STATE.businessId).order('date', { ascending: false }).limit(5);
    const { data: staff } = await STATE.supabase.from('salon_stylists').select('*').eq('business_id', STATE.businessId);
    
    const todayCount = todayAppts?.length || 0;
    const doneCount = todayAppts?.filter(a => a.status === 'done').length || 0;
    const ongoingCount = todayAppts?.filter(a => a.status === 'ongoing').length || 0;
    
    const recentHTML = allAppts?.length ? allAppts.map(a => `<div style="padding:12px;background:rgba(201,168,76,0.05);border-radius:8px;"><div style="font-weight:600;font-size:13px;">${a.client_name}</div><div style="font-size:11px;color:#888;margin-top:4px;">📅 ${a.date} • ${a.time}</div></div>`).join('') : '<div style="color:#888;text-align:center;padding:20px;">No appointments</div>';
    
    pane.innerHTML = `
      <div style="padding:24px;overflow-y:auto;">
        <h1 style="font-size:28px;font-weight:700;margin-bottom:8px;">Salon Dashboard</h1>
        <p style="color:#888;font-size:13px;margin-bottom:24px;">Manage appointments, staff & services</p>
        
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;margin-bottom:24px;">
          <div style="background:rgba(201,168,76,0.08);border:1px solid rgba(201,168,76,0.15);border-radius:12px;padding:20px;cursor:pointer;" onclick="window.selectSalonPane('appointments')">
            <div style="font-size:11px;color:#888;text-transform:uppercase;margin-bottom:8px;">📅 Today Appointments</div>
            <div style="font-size:40px;font-weight:800;color:#C9A84C;">${todayCount}</div>
            <div style="font-size:11px;color:#888;margin-top:8px;border-top:1px solid rgba(201,168,76,0.15);padding-top:8px;">✓ ${doneCount} done • ⟳ ${ongoingCount} in progress</div>
          </div>
          
          <div style="background:rgba(59,130,246,0.08);border:1px solid rgba(59,130,246,0.15);border-radius:12px;padding:20px;cursor:pointer;" onclick="window.selectSalonPane('staff')">
            <div style="font-size:11px;color:#888;text-transform:uppercase;margin-bottom:8px;">👥 Team Members</div>
            <div style="font-size:40px;font-weight:800;color:#3B82F6;">${staff?.length || 0}</div>
            <div style="font-size:11px;color:#888;margin-top:8px;border-top:1px solid rgba(59,130,246,0.15);padding-top:8px;">Ready to serve</div>
          </div>
          
          <div style="background:rgba(34,197,94,0.08);border:1px solid rgba(34,197,94,0.15);border-radius:12px;padding:20px;">
            <div style="font-size:11px;color:#888;text-transform:uppercase;margin-bottom:8px;">💰 Today Revenue</div>
            <div style="font-size:40px;font-weight:800;color:#22C55E;">KES 0</div>
            <div style="font-size:11px;color:#888;margin-top:8px;border-top:1px solid rgba(34,197,94,0.15);padding-top:8px;">From ${todayCount} appointments</div>
          </div>
        </div>
        
        <div style="background:rgba(201,168,76,0.05);border:1px solid rgba(201,168,76,0.15);border-radius:12px;padding:20px;">
          <h3 style="font-size:14px;font-weight:700;margin-bottom:12px;">Recent Appointments</h3>
          <div style="display:flex;flex-direction:column;gap:8px;">${recentHTML}</div>
        </div>
      </div>
    `;
  } catch (err) {
    pane.innerHTML = '<div style="padding:20px;color:#EF4444;">Error: ' + err.message + '</div>';
  }
};

// MENU
window.setupSalonMenu = function() {
  const nav = document.getElementById('nav-menu');
  if (!nav) return;
  
  const items = [
    { id: 'dashboard', name: 'Dashboard', icon: '📊' },
    { id: 'appointments', name: 'Appointments', icon: '📅' },
    { id: 'staff', name: 'Staff', icon: '👥' },
    { id: 'finance', name: 'Finance', icon: '💰' },
    { id: 'clients', name: 'Clients', icon: '👤' },
    { id: 'settings', name: 'Settings', icon: '⚙️' }
  ];
  
  nav.innerHTML = items.map((item, idx) => `
    <button class="nav-btn${idx === 0 ? ' active' : ''}" onclick="window.selectSalonPane('${item.id}'); event.target.closest('.nav-btn').parentElement.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active')); event.target.closest('.nav-btn').classList.add('active');">
      <span>${item.icon}</span>
      <span>${item.name}</span>
    </button>
  `).join('');
};

window.selectSalonPane = async function(paneId) {
  document.querySelectorAll('[id^="pane-"]').forEach(p => p.style.display = 'none');
  const pane = document.getElementById('pane-' + paneId);
  if (!pane) return;
  pane.style.display = 'block';
  
  if (paneId === 'dashboard') await initSalonDashboard();
  else if (paneId === 'appointments') await loadSalonAppointments();
  else if (paneId === 'staff') await loadSalonStaff();
  else if (paneId === 'finance') await loadSalonFinance();
  else if (paneId === 'clients') await loadSalonClients();
  else if (paneId === 'settings') await loadSalonSettings();
};

// APPOINTMENTS
