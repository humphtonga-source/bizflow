window.renderSalonStaff = async function() {
  const { data: staff } = await STATE.supabase.from('salon_stylists').select('*').eq('business_id', STATE.businessId);
  const list = document.getElementById('staff-list');
  if (!list) return;
  
  if (!staff?.length) {
    list.innerHTML = '<div style="text-align:center;color:#888;padding:40px;">No staff members</div>';
    return;
  }
  
  list.innerHTML = staff.map(s => `
    <div style="background:rgba(59,130,246,0.08);border:1px solid rgba(59,130,246,0.15);border-radius:10px;padding:14px;">
      <div style="display:flex;justify-content:space-between;align-items:start;">
        <div>
          <div style="font-weight:600;font-size:14px;">${s.name}</div>
          <div style="font-size:12px;color:#888;margin-top:4px;">📞 ${s.phone || 'N/A'}</div>
          <div style="font-size:12px;color:#888;margin-top:2px;">👤 ${s.role || 'Stylist'}</div>
        </div>
        <button onclick="window.deleteSalonStaff('${s.id}')" style="background:#EF4444;color:#FFF;border:none;padding:6px 12px;border-radius:6px;font-size:11px;cursor:pointer;">Delete</button>
      </div>
    </div>
  `).join('');
};

window.saveSalonStaff = async function() {
  const name = document.getElementById('staff-name')?.value.trim();
  const phone = document.getElementById('staff-phone')?.value.trim();
  const role = document.getElementById('staff-role')?.value;
  
  if (!name) { alert('Enter name'); return; }
  
  try {
    await STATE.supabase.from('salon_stylists').insert([{
      business_id: STATE.businessId,
      name,
      phone: phone || '',
      role: role || 'stylist'
    }]);
    
    document.getElementById('staff-form').style.display = 'none';
    document.getElementById('staff-name').value = '';
    document.getElementById('staff-phone').value = '';
    document.getElementById('staff-role').value = 'stylist';
    
    await window.renderSalonStaff();
  } catch (err) {
    alert('Error: ' + err.message);
  }
};

window.deleteSalonStaff = async function(id) {
  if (!confirm('Delete staff?')) return;
  try {
    await STATE.supabase.from('salon_stylists').delete().eq('id', id);
    await window.renderSalonStaff();
  } catch (err) {
    alert('Error: ' + err.message);
  }
};

